{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: quickcrawl Debug",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/quickcrawl/bin/Debug/net9.0/quickcrawl",
            "args": [
                "http://localhost:9222/json"
            ],
            "cwd": "${workspaceFolder}/quickcrawl"
        },
        {
            "name": "Attach to pwsh",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "preLaunchTask": "Start pwsh with module (inline)"
        }
    ]
}